# 阿里云百炼（Model Studio，华北2·北京）配置 —— 复制为 .env 后在等号后填写
# 获取 API Key：https://bailian.console.aliyun.com 控制台 → API Key
# 也可改用环境变量 DASHSCOPE_API_KEY（优先级更高）
DASHSCOPE_API_KEY=

# 业务空间 ID（SFM_WORKSPACE_ID）—— 端点由它决定，形如：
# https://<该ID>.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# 在控制台 → 业务空间列表 查看
SFM_WORKSPACE_ID=
